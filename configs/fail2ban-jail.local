[DEFAULT]
# Arch + systemd writes auth events to the journal, not /var/log/auth.log.
backend = systemd
bantime = 3600
findtime = 600
maxretry = 3

[sshd]
enabled = true
# NB: setup.sh rewrites `port = ssh` on install with the sshd port(s) it
# detects in sshd_config (comma-separated) — `ssh` here only means 22.
port = ssh
maxretry = 3
bantime = 3600
